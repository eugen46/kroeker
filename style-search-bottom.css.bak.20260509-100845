}
[data-theme="dark"] .card a.res-btn {
  background: #3b73f3 !important;
  color: white !important;
  box-shadow: 0 4px 12px rgba(59, 115, 243, .35);
}

/* res-link — для строчного списка "Других ресурсов" */
.card a.res-link,
a.res-link {
