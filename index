<style>
:root {
  --navy:  #1a3a6a;
  --navy2: #2a5a9a;
  --navy3: #4a8acc;
  --bg:    #ffffff;
  --card:  #f4f7fc;
  --border:#c8d8ee;
  --text:  #3a6aaa;
  --soft:  #6a9acc;
  --red:   #c0392b;
  --white: #ffffff;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); font-family: 'Source Serif 4', Georgia, serif; color: var(--text); min-height: 100vh; }

/* ── HEADER ── */
.site-header {
background: var(–navy);
padding: 0.9rem 2rem;
display: flex;
align-items: center;
justify-content: space-between;
position: sticky; top: 0; z-index: 100;
box-shadow: 0 2px 12px rgba(26,58,106,0.3);
gap: 1rem;
flex-wrap: wrap;
}
.site-logo-main { font-family:‘Playfair Display’,serif; color:#fff; font-size:1.35rem; font-weight:700; }
.site-logo-sub  { color:#a8c4e8; font-size:0.76rem; font-style:italic; margin-top:0.1rem; }

.header-right { display:flex; align-items:center; gap:1rem; flex-shrink:0; }

/* Telegram button */
.tg-btn {
display: flex; align-items: center; gap: 0.4rem;
background: #2ca5e0; color: #fff;
padding: 0.35rem 0.85rem; border-radius: 20px;
font-size: 0.8rem; font-weight: 600; text-decoration: none;
white-space: nowrap;
transition: background 0.2s;
}
.tg-btn:hover { background: #1a8fc8; }
.tg-btn svg { width:16px; height:16px; fill:#fff; flex-shrink:0; }

.lang-switcher { display:flex; gap:0.35rem; }
.lang-btn { background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.3); color:#a8c4e8; padding:0.28rem 0.75rem; cursor:pointer; font-size:0.78rem; border-radius:3px; transition:all 0.2s; }
.lang-btn:hover,.lang-btn.active { background:rgba(255,255,255,0.28); color:#fff; border-color:rgba(255,255,255,0.7); }

/* ── NAV ── */
.site-nav { background:var(–navy2); padding:0 2rem; display:flex; overflow-x:auto; box-shadow:0 2px 6px rgba(0,0,0,0.1); }
.nav-link { color:#c8ddf8; text-decoration:none; font-size:0.8rem; letter-spacing:0.07em; text-transform:uppercase; white-space:nowrap; cursor:pointer; padding:0.8rem 1.1rem; border-bottom:3px solid transparent; transition:all 0.2s; font-weight:600; }
.nav-link:hover { color:#fff; background:rgba(255,255,255,0.08); }
.nav-link.active { color:#fff; border-bottom-color:#fff; }

/* ── HERO ── */
.hero { background:linear-gradient(135deg,var(–navy) 0%,var(–navy2) 60%,#3a6aaa 100%); padding:3.5rem 2rem; text-align:center; }
.hero-title { font-family:‘Playfair Display’,serif; font-size:2.7rem; color:#fff; line-height:1.2; margin-bottom:0.6rem; font-weight:700; }
.hero-subtitle { color:#c8ddf8; font-style:italic; font-size:1.05rem; margin-bottom:0.9rem; }
.hero-dates { color:#a8c4e8; font-size:0.82rem; letter-spacing:0.2em; text-transform:uppercase; }

/* ── MAIN ── */
.main { max-width:1100px; margin:0 auto; padding:2rem; }
.section { display:none; }
.section.active { display:block; }
.section-title { font-family:‘Playfair Display’,serif; font-size:1.65rem; color:var(–navy); margin-bottom:1.5rem; padding-bottom:0.6rem; border-bottom:2px solid var(–navy3); font-weight:700; }

/* ── CARDS ── */
.card { background:var(–card); border-radius:4px; padding:1.4rem 1.7rem; margin-bottom:1.4rem; box-shadow:0 1px 8px rgba(26,58,106,0.07); border:1px solid var(–border); border-top:3px solid var(–navy2); }
.card-title { font-family:‘Playfair Display’,serif; font-size:1.05rem; color:var(–navy); margin-bottom:0.7rem; padding-bottom:0.45rem; border-bottom:1px solid var(–border); font-weight:700; }
.card p { line-height:1.75; color:var(–text); font-size:0.93rem; margin-bottom:0.5rem; }
.card p:last-child { margin-bottom:0; }

.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1.4rem; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:1.4rem; }
@media(max-width:750px){ .grid-2,.grid-3{grid-template-columns:1fr;} .hero-title{font-size:1.8rem;} .site-header{flex-direction:column;align-items:flex-start;} }

.question-box { background:#fff0f0; border-left:4px solid var(–red); padding:1rem 1.3rem; margin:1rem 0; font-size:0.91rem; color:var(–navy); line-height:1.7; border-radius:0 4px 4px 0; }
.question-box strong { color:var(–red); }

/* ── TREE ── */
.tree-container { background:var(–white); padding:2rem; border-radius:4px; box-shadow:0 1px 8px rgba(26,58,106,0.07); border:1px solid var(–border); overflow-x:auto; }
.tree { display:flex; flex-direction:column; align-items:center; min-width:820px; }
.tree-level { display:flex; gap:1.5rem; justify-content:center; width:100%; padding:0.4rem 0; }
.tree-connector { height:1.5rem; display:flex; justify-content:center; position:relative; width:100%; }
.tree-connector::after { content:’’; position:absolute; top:0; left:50%; width:1px; height:100%; background:var(–navy2); }
.tree-connector-h { height:0; border-top:1px solid var(–navy2); width:40%; margin:0 auto; }
.tree-node { background:var(–white); border:1.5px solid var(–border); border-top:3px solid var(–navy2); border-radius:4px; padding:0.7rem 0.9rem; min-width:160px; max-width:195px; text-align:center; position:relative; box-shadow:0 1px 5px rgba(26,58,106,0.07); }
.tree-node::before { content:’’; position:absolute; top:-0.5rem; left:50%; transform:translateX(-50%); width:1px; height:0.5rem; background:var(–navy2); }
.tree-node.you { border-color:var(–navy); border-top:3px solid var(–navy); background:#e8f0fc; box-shadow:0 2px 10px rgba(26,58,106,0.13); }
.tree-node.unknown { border-style:dashed; border-top-style:dashed; border-color:#aabbd0; background:#f8fafc; }
.node-name { font-family:‘Playfair Display’,serif; font-size:0.86rem; font-weight:700; color:var(–navy); margin-bottom:0.2rem; }
.node-dates { font-size:0.7rem; color:var(–soft); line-height:1.4; }
.node-tag { display:inline-block; font-size:0.63rem; padding:0.1rem 0.42rem; border-radius:10px; margin-top:0.28rem; background:#deeaf8; color:var(–navy2); font-weight:600; }
.node-tag.unknown-tag { background:#f0f4f8; color:#7a9abc; }
.node-tag.you-tag { background:#d0e2f8; color:var(–navy); font-weight:700; }

/* ── STATUS TABLE ── */
.status-table { width:100%; border-collapse:collapse; font-size:0.86rem; }
.status-table th { background:var(–navy); color:#fff; padding:0.7rem 1rem; text-align:left; font-family:‘Playfair Display’,serif; font-weight:700; }
.status-table tr:nth-child(even) td { background:#f0f6ff; }
.status-table td { padding:0.7rem 1rem; border-bottom:1px solid var(–border); color:var(–text); vertical-align:top; line-height:1.5; }
.status-table td strong { color:var(–navy); }
.status-dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:0.4rem; vertical-align:middle; }
.dot-wait{background:#e67e22;} .dot-done{background:#27ae60;} .dot-deny{background:#c0392b;}

/* ── TIMELINE ── */
.timeline { position:relative; padding-left:2.5rem; }
.timeline::before { content:’’; position:absolute; left:0.7rem; top:0; bottom:0; width:2px; background:linear-gradient(180deg,var(–navy2),var(–navy3)); border-radius:2px; }
.tl-item { position:relative; padding-bottom:1.4rem; }
.tl-item::before { content:’’; position:absolute; left:-1.85rem; top:0.35rem; width:10px; height:10px; border-radius:50%; background:var(–navy2); border:2px solid var(–white); box-shadow:0 0 0 2px var(–navy2); }
.tl-year { font-family:‘Playfair Display’,serif; color:var(–navy); font-size:0.98rem; font-weight:700; margin-bottom:0.15rem; }
.tl-text { color:var(–text); font-size:0.88rem; line-height:1.6; }

/* ── UPDATES ── */
.update-item { padding:0.75rem 0; border-bottom:1px dashed var(–border); }
.update-date { color:var(–navy2); font-family:‘Playfair Display’,serif; font-size:0.83rem; font-weight:700; }
.update-text { color:var(–text); line-height:1.5; margin-top:0.18rem; font-size:0.88rem; }

/* ── FOOTER ── */
.footer { background:var(–navy); padding:1.6rem 2rem; text-align:center; color:#a8c4e8; font-size:0.8rem; font-style:italic; margin-top:3rem; }
</style>

</head>
